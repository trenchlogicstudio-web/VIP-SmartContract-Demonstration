# VIP SmartContract · MVP v0.2.11 — evaluation configuration
# AS-IS evaluation artifact — 09_AS_IS_Notice of the VIP SmartContract package governs.
# Nothing reads a .env file: export these in the shell before `npm start`. All are optional.

# HTTP port
PORT=3400

# SQLite file (created + seeded on first boot; `npm run reset` deletes it)
VIP_DB=./vip-mvp.db

# Guards /admin and /vip/guest/erase.
# The default is for local evaluation only — change it even for demos.
VIP_ADMIN_TOKEN=evaluation-only

# Instance default mode when a pre-commit call omits one: hard_stop | advisory
# (both modes are always evaluable regardless of this default)
VIP_MODE=hard_stop

# ── policy thresholds · per-jurisdiction configurables ──────────────
# Each is validated at startup. A value that is not a finite number in
# range stops the process; it never softens the limit.
# Fractions of the pre-committed budget:
VIP_THRESHOLD=0.50
VIP_NUDGE=0.40
VIP_ESCALATE=0.85
# Fraction of preserved budget issued as rollover credit:
VIP_ROLLOVER=0.20
# Shares of preserved budget issued as resort credit. Per-jurisdiction
# configurable: move them where a regulator caps F&B credit or bars retail
# vouchers. Validated by the same rule as every threshold above, and the
# process refuses to start if rollover plus the three shares would exceed the
# preserved budget. Each fraction is read to the nearest millionth, so shares
# that sum to exactly 1 are accepted however floating point would add them.
VIP_SPLIT_SPA=0.30
VIP_SPLIT_FNB=0.25
VIP_SPLIT_RETAIL=0.15

# ── Path 2 · downstream (dormant unless BOTH are set) ──────────────
# See INTEGRATION.md for the event contract and delivery semantics.
#VIP_DOWNSTREAM_URL=https://your-endpoint.example/events
#VIP_DOWNSTREAM_KEY=replace-me

# ── RG eligibility gate ──────────────────────────────────────────────────
# permitted | suppressed. permitted is the reference configuration every canon
# figure was computed under. suppressed withholds the incentive everywhere in
# this process: the stop still fires and the whole preserved budget returns to
# the guest. The stricter of this and the per-session value always wins.
# VIP_ELIGIBILITY_DEFAULT=permitted

# Absolute euro ceiling on redirect + rollover. Unset means uncapped, which is
# the reference configuration. When it binds the excess goes to the guest.
# VIP_REWARD_CAP_EUR=500

# How many days the operator's eligibility determination stays good for.
# Unset means it never expires, which is the reference configuration. When set
# and the determination is older, the gate fails CLOSED: nothing is issued until
# a fresh determination arrives. An absent determination date counts as expired.
# VIP_ELIGIBILITY_TTL_DAYS=90
